# Copy to .env and edit. Everything is optional — the app runs with these defaults.

PORT=8150

# Password for /admin. CHANGE THIS before the event.
ADMIN_PASSWORD=bni-admin

# Event title shown everywhere (can also be changed live from /admin).
EVENT_TITLE=BNI Gala Awards

# Address of the frontend that players open (shown under the QR code). Leave blank when running
# on a laptop — the server then uses this machine's Wi-Fi IP automatically.
# When hosted, set it to the frontend URL, e.g. https://bni-arena.vercel.app — this also allows
# that site to call the API.
PUBLIC_URL=

# Other frontend addresses allowed to call the API, comma-separated (e.g. a custom domain).
CORS_ORIGINS=

# Leave blank to store data in data/db.json. Set it to use MongoDB (e.g. Atlas) instead —
# needed when hosting on a platform whose disk is wiped on every deploy/restart.
MONGODB_URI=
MONGODB_DB=bni_arena
